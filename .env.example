# ==========================================
# MangoVision Configuration Environment Variables
# ==========================================

# Database Settings
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mangovision
POSTGRES_DB=mangovision
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# Security & Authentication
JWT_SECRET_KEY=mangovision-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning Engine
ML_MODE=mock
MODEL_PATH=/app/ml/weights/mango_efficientnet.pt

# File Storage
STORAGE_PATH=./storage

# Web Application
VITE_API_BASE_URL=http://localhost:8000/api

# Mobile Application
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api
